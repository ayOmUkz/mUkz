# Copy this file to .env and fill in real values. NEVER commit .env.
# Every secret the engine needs lives here — nothing is hard-coded.

# Unusual Whales public API token (https://unusualwhales.com/api)
UW_API_TOKEN=***

# Storage (docker-compose defaults; override for other setups)
DATABASE_URL=postgresql+psycopg://darkpool:darkpool@localhost:5432/darkpool
REDIS_URL=redis://localhost:6379/0

# Email digest (optional — leave blank to disable email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
